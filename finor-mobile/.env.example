# Android USB (adb reverse) ou simulador iOS no Mac.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080/api/v1
# iPhone/Android por Wi-Fi: use o IP do computador em vez de 127.0.0.1.
# Builds preview/production: use a URL HTTPS pública da mesma API.
# Ative somente para compilar o iOS local com acesso HTTP à rede de desenvolvimento.
FINOR_ALLOW_LOCAL_NETWORK=0
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Opcional: chave Web; usa src/lib/firebase.ts quando ausente.
EXPO_PUBLIC_FIREBASE_API_KEY=
