# Backend Firebase / Cloud Firestore
SPRING_PROFILES_ACTIVE=firestore
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
# Produção fora do Google Cloud: caminho para JSON de conta de serviço; nunca cole o JSON aqui.
GOOGLE_APPLICATION_CREDENTIALS=
# Apenas desenvolvimento: 127.0.0.1:8085 e projeto demo-finor. Em produção deixe vazio.
FIRESTORE_EMULATOR_HOST=
JWT_SECRET=

# GroqCloud: somente o backend usa esta chave.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_CHAT_COMPLETIONS_URL=https://api.groq.com/openai/v1/chat/completions
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# SMTP continua separado do banco e da GroqCloud.
MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=false
SMTP_TEST_TO=

